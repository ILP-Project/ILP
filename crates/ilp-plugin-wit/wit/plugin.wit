/// ILP 插件接口。
///
/// 设计要点：
/// - 插件是沙箱，不能自己发 HTTP、读写文件、用 SQLite；这些全部经 host 注入。
/// - 正文抓取分两阶段：插件产出抓取计划，宿主执行（并发/限速/重试全在宿主），
///   再把响应交回插件解析。这样 30 章/批的批量接口和 1 章/请求的网页接口
///   共用同一套 ABI，并发策略也不用在每个插件里重写一遍。
package ilp:plugin@0.1.0;

/// 插件与宿主之间传递的数据类型。
interface types {
  /// 章节目录条目。
  record chapter-entry {
    id: string,
    title: string,
    /// 阅读页地址
    url: string,
    /// 内容获取地址（网页型插件即正文页；批量型插件可留空）
    fetch-url: string,
    /// 更新时间（Unix 秒）
    update-time: s64,
  }

  /// 搜索结果条目。
  record search-result {
    id: string,
    title: string,
    author: string,
    /// 封面地址，可能为空
    cover-url: string,
    /// 简介摘要
    description: string,
  }

  record plugin-metadata {
    /// 插件编译时依据的 ABI 版本。宿主在加载阶段比对，
    /// 不匹配直接拒绝，避免"加载成功、某次调用才炸"。
    abi-version: string,
    site-name: string,
    site-id: string,
    site-domain: string,
    plugin-name: string,
    plugin-id: string,
    version: string,
  }

  record http-header {
    name: string,
    value: string,
  }

  /// 宿主代发的请求。
  record http-request {
    method: string,
    url: string,
    headers: list<http-header>,
    body: option<list<u8>>,
  }

  /// 宿主回传的响应。
  record http-response {
    status: u16,
    headers: list<http-header>,
    body: list<u8>,
  }

  /// 一个抓取任务。id 用于把响应与请求对应回去。
  record fetch-task {
    id: string,
    request: http-request,
  }

  /// 解析产物：一章的正文。
  record chapter-content {
    id: string,
    title: string,
    /// 已渲染成纯文本的正文
    text: string,
  }

  /// 一页搜索结果。
  ///
  /// 分页是游标式的，不是 offset 式的：番茄的搜索接口会直接忽略 offset
  /// 参数，必须把上一页返回的 cursor 原样带回去才能翻到下一页。
  /// 宿主因此只能"下一页/上一页"，无法跳到任意页。
  record search-page {
    results: list<search-result>,
    /// 下一页游标；has-more 为 false 时无意义
    cursor: string,
    has-more: bool,
  }
}

/// 宿主提供给插件的能力。
interface host {
  use types.{http-request, http-response};

  /// 写日志。level: 0=error 1=warn 2=info 3=debug 4=trace
  log: func(level: u8, message: string);

  /// 当前 UTC epoch 毫秒（插件沙箱里没有系统时钟）。
  now-ms: func() -> u64;

  /// 同步 HTTP。用于目录/搜索/元数据这类一次性请求：插件发起，
  /// 宿主统一处理代理、超时、UA。
  /// 正文不走这里——正文量大，走下面 plugin 接口的两阶段抓取。
  http-fetch: func(request: http-request) -> result<http-response, string>;

  /// 插件私有 KV。宿主按插件名隔离，实际落盘路径由宿主决定，
  /// 插件只见到 key，不可能路径穿越。
  storage-get: func(key: string) -> option<list<u8>>;
  storage-set: func(key: string, value: list<u8>) -> result<_, string>;
  storage-delete: func(key: string) -> result<_, string>;
}

/// 插件必须实现的接口。
interface plugin {
  use types.{
    chapter-content, chapter-entry, fetch-task, http-response, plugin-metadata,
    search-page,
  };

  /// 元数据，加载时调用一次。
  metadata: func() -> plugin-metadata;

  /// 绑定小说并预热（可能触发一次目录抓取）。
  init: func(book-id: string, force-update: bool) -> result<_, string>;

  title: func() -> result<string, string>;
  author: func() -> result<string, string>;
  cover-url: func() -> result<string, string>;
  description: func() -> result<string, string>;

  /// 章节目录。
  catalog: func(force-update: bool) -> result<list<chapter-entry>, string>;

  /// 搜索。cursor 为空表示取第一页，否则原样传入上一页返回的 cursor。
  search: func(keyword: string, cursor: string) -> result<search-page, string>;

  /// 第一阶段：给定章节 id，产出要发的请求。
  /// 批量站点一次返回一个任务覆盖多章，网页站点每章一个任务。
  plan-fetch: func(chapter-ids: list<string>) -> result<list<fetch-task>, string>;

  /// 第二阶段：把响应交回来，插件解密/解析成正文。
  /// 返回空列表表示该任务失败（宿主记 failed 继续下一批）。
  consume-fetch: func(task-id: string, response: http-response) -> result<list<chapter-content>, string>;
}

world novel-plugin {
  import host;
  export plugin;
}
